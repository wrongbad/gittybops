// Members of group www may start, stop and restart the per-site units (deploy now, back up now, roll back,
// restart a server) without sudo. Installed by install.sh as /etc/polkit-1/rules.d/50-gittybops.rules.
polkit.addRule(function (action, subject) {
  if (action.id != 'org.freedesktop.systemd1.manage-units' || !subject.isInGroup('www')) return
  var unit = action.lookup('unit') || ''
  var verb = action.lookup('verb') || ''
  if (/^www(-deploy|-backup|-rollback)?@[a-z0-9-]+\.service$/.test(unit) &&
      (verb == 'start' || verb == 'stop' || verb == 'restart')) {
    return polkit.Result.YES
  }
})
