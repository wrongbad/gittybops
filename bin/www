#!/bin/sh
# Day-to-day commands, no sudo:
#   www status                                   each site's deployed commit
#   www deploy|backup|restart SITE      do it now, and follow the log (ctrl-c stops following)
#   www log SITE                                 follow everything about SITE
set -eu
cmd=${1:-}
site=${2:-}
case $cmd in
	status)
		for f in /www/gittybops/site/*; do
			echo "${f##*/}: $(cat "/www/sites/${f##*/}/deployed" 2>/dev/null || echo never built)"
		done ;;
	log)
		exec journalctl -f -u "www*@$site.*" ;;
	deploy|backup|restart)
		[ -e "/www/gittybops/site/$site" ] || { echo "no site '$site'" >&2; exit 1; }
		touch "/www/gittybops/trigger/$cmd-$site"
		exec journalctl -f -n 0 -u "www-$cmd@$site" -u "www@$site" ;;
	*)
		echo "usage: www status | www deploy|backup|restart SITE | www log SITE" >&2
		exit 2 ;;
esac
