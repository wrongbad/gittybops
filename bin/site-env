#!/bin/sh
# site-env SITE CMD...: run CMD with SITE's environment. Every unit that runs as a site's user starts this way.
#   SITE, REPO, BRANCH, PORT, DATA_DIR    from SITE's line in sites.conf
#   then the box's env/SITE.env, then the site's secrets in /www/sites/SITE/.env (KEY=value lines)
# The files are read here, as the site's user, not by systemd as root, so a symlink in the site's directory
# can't expose a file only root may read.
set -eu
SITE=$1
shift
read -r REPO BRANCH PORT < "/www/gittybops/site/$SITE"
DATA_DIR=/www/sites/$SITE/data
export SITE REPO BRANCH PORT DATA_DIR
[ "$PORT" != - ] || unset PORT

load() {
	[ -f "$1" ] || return 0
	while IFS= read -r line || [ -n "$line" ]; do
		case $line in ''|'#'*) ;; *) export "$line" ;; esac
	done < "$1"
}
load "/www/gittybops/env/$SITE.env"
load "/www/sites/$SITE/.env"
exec "$@"
