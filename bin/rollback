#!/bin/sh
# ExecStart of www-rollback@<site>, as the site's user: point current at the other slot (the previous build,
# until the next deploy reuses that slot) and restart the server on it. Running it again rolls forward.
set -eu
dir=/www/sites/$SITE
[ "$(readlink "$dir/current")" = a ] && prev=b || prev=a
[ -d "$dir/$prev/.git" ] || { echo "$SITE has no previous build" >&2; exit 1; }
ln -sfn "$prev" "$dir/current.new"
mv -T "$dir/current.new" "$dir/current"
date +%s > "$dir/restart"
echo "$SITE now on $(git -C "$dir/$prev" rev-parse HEAD) in $prev"
