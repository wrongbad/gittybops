# Restart the server after a deploy or rollback (they touch /www/sites/<site>/restart), on `www restart
# <site>`, or when setup changes its config (it touches the trigger).
[Path]
PathChanged=/www/sites/%i/restart
PathModified=/www/gittybops/trigger/restart-%i
Unit=www-restart@%i.service

[Install]
WantedBy=paths.target
