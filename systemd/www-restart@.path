# A deploy or rollback touches /www/sites/<site>/restart once current points at the new build; `www restart
# <site>` and install.sh (for new config) touch /www/trigger/restart-<site>.
[Path]
PathChanged=/www/sites/%i/restart
PathModified=/www/trigger/restart-%i
Unit=www-restart@%i.service

[Install]
WantedBy=paths.target
