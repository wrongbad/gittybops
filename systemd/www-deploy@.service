[Unit]
Description=deploy %i

[Service]
Type=oneshot
User=www-%i
Environment=PATH=/opt/node/bin:/opt/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin RUSTUP_HOME=/opt/rustup
EnvironmentFile=/www/sites/%i/site.env
ExecStart=/opt/gittybops/bin/build
Nice=10
TimeoutStartSec=1h
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/www/sites/%i
