[Unit]
Description=deploy %i

[Service]
Type=oneshot
User=www-%i
Environment=PATH=/www/tools/node/bin:/www/tools/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin RUSTUP_HOME=/www/tools/rustup
ExecStart=/www/live/engine/bin/site-env %i /www/live/engine/bin/build
Nice=10
TimeoutStartSec=1h
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/www/sites/%i
