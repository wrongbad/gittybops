[Unit]
Description=%i site server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0
ConditionFileIsExecutable=/www/sites/%i/current/deploy/start

[Service]
User=www-%i
WorkingDirectory=/www/sites/%i/current
Environment=PATH=/www/tools/node/bin:/www/tools/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin RUSTUP_HOME=/www/tools/rustup
ExecStart=/www/live/engine/bin/site-env %i /www/sites/%i/current/deploy/start
Restart=always
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/www/sites/%i

[Install]
WantedBy=multi-user.target
