[Unit]
Description=%i site server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0
ConditionFileIsExecutable=/www/sites/%i/current/deploy/start

[Service]
User=www-%i
WorkingDirectory=/www/sites/%i/current
Environment=PATH=@PATH@
ExecStart=/www/gittybops/bin/site-env %i /www/sites/%i/current/deploy/start
Restart=always
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/www/sites/%i

[Install]
WantedBy=multi-user.target
