[Unit]
Description=GitHub push webhook listener
After=network.target

[Service]
DynamicUser=yes
RuntimeDirectory=www-hook
RuntimeDirectoryPreserve=yes
LoadCredential=secret:/etc/www/hook-secret
Environment=PATH=@PATH@
ExecStart=/usr/bin/env node /www/gittybops/hook/hook.mjs
Restart=always

[Install]
WantedBy=multi-user.target
