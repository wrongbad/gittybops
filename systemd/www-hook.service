[Unit]
Description=GitHub push webhook listener
After=network.target

[Service]
DynamicUser=yes
RuntimeDirectory=www-hook
RuntimeDirectoryPreserve=yes
LoadCredential=secret:/etc/www/hook-secret
ExecStart=/www/tools/node/bin/node /www/live/engine/hook/hook.mjs
Restart=always

[Install]
WantedBy=multi-user.target
